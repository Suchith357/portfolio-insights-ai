# PortfolioIQ backend — copy to .env and fill in local values. Never commit .env.

# Local PostgreSQL (see docker-compose.yml for a zero-cost local instance)
DATABASE_URL="postgresql://USERNAME:PASSWORD@localhost:5432/portfolioiq?schema=public"

# Auth
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="7d"
BCRYPT_ROUNDS="10"

# Server
PORT="4000"
NODE_ENV="development"
CORS_ORIGIN="http://localhost:8080"

# Seed accounts (demo only — never use real credentials)
SEED_USER_PASSWORD="change-me-user"
SEED_ADMIN_PASSWORD="change-me-admin"
