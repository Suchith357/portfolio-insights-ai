# PortfolioIQ backend — copy to .env and fill in local values. Never commit .env.

# Local PostgreSQL (see docker-compose.yml for a zero-cost local instance)
DATABASE_URL="postgresql://USERNAME:PASSWORD@localhost:5432/portfolioiq?schema=public"

# Auth
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="7d"
BCRYPT_ROUNDS="10"

# Server
PORT="4000"
NODE_ENV="development"
CORS_ORIGIN="http://localhost:8080"

# Seed accounts (demo only — never use real credentials)
# Leave unset to use the login-page demo credentials (demo1234 / admin1234).
# The values below are placeholders; set real ones only for non-demo setups.
SEED_USER_PASSWORD="demo1234"
SEED_ADMIN_PASSWORD="admin1234"

# ---------------------------------------------------------------------------
# Intelligence Engine — Phase 1 news foundation (all optional)
# ---------------------------------------------------------------------------
# News provider: GDELT (default, free, no key) or MARKETAUX (free tier, needs token).
# NEWS_PROVIDER="GDELT"
# Required only when NEWS_PROVIDER=MARKETAUX. Never expose this to the frontend.
# NEWS_MARKETAUX_API_TOKEN=""
# News pipeline cadence (minutes) and raw-news retention (hours).
# NEWS_FETCH_INTERVAL_MINUTES="30"
# NEWS_CLEANUP_INTERVAL_MINUTES="60"
# NEWS_RETENTION_HOURS="72"
# Provider request budget.
# NEWS_FETCH_LIMIT="50"
# NEWS_PROVIDER_TIMEOUT_MS="15000"

# ---------------------------------------------------------------------------
# AI / RAG foundation (local, free, offline — no paid APIs)
# Runtime: Ollama (https://ollama.com). Models: qwen3:4b-instruct (4-bit) and
# qwen3-embedding:0.6b. ~3.1 GB on disk, ~5.3 GB VRAM at ctx 4096 — fits the
# RTX 4050 6 GB target. If AI_ENABLED=false or Ollama is absent, every other
# PortfolioIQ feature is unaffected.
# ---------------------------------------------------------------------------
# AI_ENABLED=true
# OLLAMA | NONE
# AI_RUNTIME=OLLAMA
# AI_OLLAMA_BASE_URL=http://127.0.0.1:11434
# AI_LLM_MODEL=qwen3:4b-instruct-2507-q4_K_M
# AI_LLM_QUANTIZATION=q4_K_M
# AI_EMBEDDING_MODEL=qwen3-embedding:0.6b
# AI_LLM_CONTEXT_LENGTH=4096
# AI_LLM_TEMPERATURE=0.2
# AI_LLM_MAX_TOKENS=512
# AI_LLM_TIMEOUT_MS=90000
# AI_RAG_TOP_K=6
# AI_RAG_MIN_SCORE=0.35
# AI_RAG_MAX_EVIDENCE_CHARS=6000
# Optional: relocate FAISS index + metadata (default <backend>/data/ai)
# AI_DATA_DIR=""

# ---------------------------------------------------------------------------
# Feature A: multi-provider market data (all optional — Yahoo is keyless and
# primary; Alpha Vantage serves only as fallback when this key is set).
# Free tier: ~25 req/day, 5 req/min. Get a free key: alphavantage.co
# ---------------------------------------------------------------------------
# ALPHA_VANTAGE_API_KEY=""

# ---- Prompt 4: deep AI stock research (decision framework + cache) ----
# Decision factor weights (financial_quality,momentum,risk,news_outlook,relative_performance,evidence_quality).
# Must sum to 1.0 within tolerance; invalid values fall back to documented defaults.
# AI_DECISION_WEIGHTS=0.20,0.15,0.15,0.20,0.15,0.15
# Cache lifetime (minutes) for a research report whose evidence fingerprint is unchanged.
# AI_RESEARCH_CACHE_MINUTES=45
