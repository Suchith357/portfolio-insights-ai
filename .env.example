# PortfolioIQ root environment — placeholders ONLY. Never commit real secrets.
# Copy to `.env` (git-ignored) and fill in before `docker compose up`.

# ---- PostgreSQL (compose `db` service) --------------------------------------
POSTGRES_PASSWORD=change-me-strong-password

# ---- Backend ----------------------------------------------------------------
JWT_SECRET=generate-a-long-random-string-at-least-32-chars
CORS_ORIGIN=http://localhost:3000

# ---- Optional market/news providers (₹0 without them) -----------------------
# Yahoo Finance (market data) and GDELT (news) need NO keys.
ALPHA_VANTAGE_API_KEY=
MARKETAUX_API_KEY=

# ---- Local AI (Ollama on the host) ------------------------------------------
# Leave the default if Ollama runs on your machine (not in a container).
# AI degrades to UNAVAILABLE when unreachable; nothing else breaks.
AI_OLLAMA_BASE_URL=http://host.docker.internal:11434
