# PortfolioIQ frontend (TanStack Start / Nitro).
#
# Default Docker target uses the node-server Nitro preset so the SSR build
# can serve traffic as a plain Node process. (Local development on this
# machine uses the cloudflare-module preset; NITRO_PRESET below overrides it
# for Docker without touching vite.config.ts.)
#
# The frontend talks to the backend at VITE_API_BASE_URL (default "/api").
# In the compose file the backend is reachable at http://backend:4000/api.
FROM node:22-bookworm-slim AS build
WORKDIR /app

COPY package.json package-lock.json* ./
RUN npm ci

COPY . .
RUN npm run build -- --mode production

FROM node:22-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production

COPY --from=build /app/.output ./.output
EXPOSE 3000

# Nitro node-server preset entrypoint. PORT/HOST come from the environment.
CMD ["node", ".output/server/index.mjs"]
