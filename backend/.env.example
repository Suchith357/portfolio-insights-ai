# PortfolioIQ backend — copy to .env and fill in local values. Never commit .env.

# Local PostgreSQL (see docker-compose.yml for a zero-cost local instance)
DATABASE_URL="postgresql://USERNAME:PASSWORD@localhost:5432/portfolioiq?schema=public"

# Auth
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="7d"
BCRYPT_ROUNDS="10"

# Server
PORT="4000"
NODE_ENV="development"
CORS_ORIGIN="http://localhost:8080"

# Seed accounts (demo only — never use real credentials)
# Leave unset to use the login-page demo credentials (demo1234 / admin1234).
# The values below are placeholders; set real ones only for non-demo setups.
SEED_USER_PASSWORD="demo1234"
SEED_ADMIN_PASSWORD="admin1234"
